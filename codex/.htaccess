# Limites de upload do Codex Web (arquivos grandes para analise).
# Para aumentar/diminuir, ajuste os valores abaixo (MB).

<IfModule mod_env.c>
    SetEnv CODEX_WEB_MAX_UPLOAD_MB 512
</IfModule>

<IfModule php_module>
    php_value upload_max_filesize 512M
    php_value post_max_size 560M
    php_value max_input_time 600
    php_value max_execution_time 600
</IfModule>
